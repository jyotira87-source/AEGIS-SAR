# Copy this file to `.env` and adjust before running the backend.
# Zero-trust token required on every request via the X-ZeroTrust-Token header.
AEGIS_ZERO_TRUST_TOKEN=aegis-ntro-secure-token-2026

# Optional overrides
# AEGIS_HOST=0.0.0.0
# AEGIS_PORT=8000
# AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000