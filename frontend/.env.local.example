# Copy this file to `.env.local` and adjust before running the frontend.
# Must match AEGIS_ZERO_TRUST_TOKEN configured on the backend.
NEXT_PUBLIC_AEGIS_TOKEN=aegis-ntro-secure-token-2026

# Optional: backend API target for the /api/* proxy rewrite (next.config.js)
# AEGIS_API_URL=http://127.0.0.1:8000

# Satellite imagery: NO TOKEN REQUIRED. The map uses MapLibre GL with free
# Esri World Imagery raster tiles (InteractiveVesselMap.jsx). No
# NEXT_PUBLIC_MAPBOX_TOKEN is needed.